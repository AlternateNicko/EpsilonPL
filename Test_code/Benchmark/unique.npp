
// Test code that tackles Condition Parsing, Evaluation, Function calls, and For loops

public func fizzbuzz(num) {
    if (num % 3 == 0) && (num % 5 ==0) {
        output("FizzBuzz")
    }
    else if (num % 3 == 0) {
        output("Fizz")
    }
    else if (num % 5 == 0) {
        output("Buzz")
    }
}

for i in range(1000) {
   call fizzbuzz(i)
}
