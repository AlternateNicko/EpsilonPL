
public func ctf(celsius) {
    exp = 32 + (celsius * 9/5)
    return exp
}

public func ftc(fahrenheit) {
    exp = 5/9 * (fahrenheit - 32)
    return exp
}

public func ctk(celsius) {
    exp = celsius + 273.15
    return exp
}

public func ktc(kelvin) {
    exp = kelvin - 273.15
    return exp
}

public func ftk(fahrenheit) {
    celsius = call ftc(fahrenheit)
    exp = call ctk(celsius)
    return exp
}
